     run([build('test_servo',[tests/'test_servo.c',src/'car_servo.c'],[tests/'sdk',inc])])
     if (tests/'test_uart8.c').exists():
         files=[tests/'test_uart8.c',src/'car_core.c',src/'car_app.c',src/'car_servo.c']
--- C3/code/repair/hold_protocol.ps1
+++ H1/code/repair/hold_protocol.ps1
@@ -0,0 +1,54 @@
+function Hold-Fields([string]$Line){
+    $d=@{};foreach($m in [regex]::Matches($Line,'(?:^|\s)([a-z_]+)=([^\s]+)')){
+        $k=$m.Groups[1].Value;if($d.ContainsKey($k)){throw 'Duplicate hold field'};$d[$k]=$m.Groups[2].Value
+    };return $d
+}
+function Parse-HoldConfig([string]$Line){
+    if(-not $Line.StartsWith('HOLD-CFG ')){throw 'Not a hold configuration'}
+    $d=Hold-Fields $Line
+    if($d.v -ne '20261019H1'){throw 'Unknown hold firmware'}
+    $expected=@{step=100;cap=3000;kick=3000;kick_min=200;kick_max=300;hold=3000;lease=500;guard=1500}
+    foreach($k in $expected.Keys){if($d[$k] -notmatch '^\d+$' -or [long]$d[$k] -ne $expected[$k]){throw "Unexpected hold config: $k"}}
+    if($d.selected -notmatch '^\d+$' -or [int]$d.selected -gt 3000 -or [int]$d.selected%100 -ne 0){throw 'Invalid hold selection'}
+    $o=[ordered]@{v=$d.v;selected=[int]$d.selected};foreach($k in $expected.Keys){$o[$k]=$expected[$k]}
+    return [pscustomobject]$o
+}
+function Parse-HoldState([string]$Line){
+    if(-not $Line.StartsWith('HOLD-STATE ')){throw 'Not a hold state'}
+    $d=Hold-Fields $Line;$o=[ordered]@{}
+    foreach($k in @('ms','mode','fault','id','phase','result','total_ms','hold_ms','motor','duty','n','sum','min','max','zeros','kick_ticks')){
+        if($d[$k] -notmatch '^-?\d+$'){throw "Missing hold state: $k"};$o[$k]=[long]$d[$k]
+    }
+    foreach($k in @('enc','pwm')){
+        $m=[regex]::Match($d[$k],'^(-?\d+),(-?\d+)$');if(-not $m.Success){throw 'Invalid hold pair'}
+        $o[$k+'_left']=[long]$m.Groups[1].Value;$o[$k+'_right']=[long]$m.Groups[2].Value
+    }
+    return [pscustomobject]$o
+}
+function Get-HoldOutcome($State,[long]$Id,[int]$Motor,[int]$Duty){
+    $s=$State
+    if($s.id -ne $Id -or $s.motor -ne $Motor -or $s.duty -ne $Duty){throw 'Hold identity/side/duty mismatch'}
+    if($s.fault -ne 0 -or $s.mode -notin @(0,8)){throw 'Hold fault or unexpected mode'}
+    $active=if($Motor -eq 1){$s.enc_left}else{$s.enc_right}
+    $other=if($Motor -eq 1){$s.enc_right}else{$s.enc_left}
+    $pwm=if($Motor -eq 1){$s.pwm_left}else{$s.pwm_right}
+    $otherPwm=if($Motor -eq 1){$s.pwm_right}else{$s.pwm_left}
+    if($active -lt -5 -or $active -gt 1500 -or [math]::Abs($other) -gt 10 -or $pwm -lt 0 -or $pwm -gt 3000 -or $otherPwm -ne 0){throw 'Abnormal hold feedback or output'}
+    if($s.kick_ticks -lt 0 -or $s.kick_ticks -gt 3 -or ($s.phase -in @(2,3) -and $s.kick_ticks -ne 3)){throw 'Kick confirmation missing'}
+    if($s.phase -in @(1,2)){
+        if($s.mode -ne 8 -or $s.result -ne 0){throw 'Invalid active hold state'}
+        if($s.phase -eq 1 -and $pwm -ne 3000 -and -not ($s.total_ms -eq 0 -and $pwm -eq 0)){throw 'Unexpected kick output'}
+        if($s.phase -eq 2 -and $pwm -ne $Duty){throw 'Unexpected sustain output'}
+        return 'pending'
+    }
+    if($s.phase -ne 3 -or $s.mode -ne 0 -or $s.pwm_left -ne 0 -or $s.pwm_right -ne 0){throw 'Interrupted hold is not a completed measurement'}
+    if($s.result -eq 2){
+        if($s.hold_ms -lt 500 -or $s.hold_ms -ge 3000){throw 'Invalid lost-motion timing'}
+        return 'lost_motion'
+    }
+    if($s.result -ne 1 -or $s.hold_ms -ne 3000 -or $s.total_ms -lt 3200 -or $s.total_ms -gt 3300 -or $s.n -ne 200){throw 'Incomplete hold window'}
+    $mean=$s.sum/[double]$s.n
+    if($s.min -gt $s.max -or $mean -lt $s.min -or $mean -gt $s.max -or $s.zeros -lt 0 -or $s.zeros -gt $s.n){throw 'Invalid hold statistics'}
+    if($s.min -ge 2 -and $s.zeros -eq 0){return 'continuous'}
+    return 'intermittent'
+}
--- C3/code/repair/test_hold_protocol.ps1
+++ H1/code/repair/test_hold_protocol.ps1
@@ -0,0 +1,29 @@
+param([string]$Fixture)
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'hold_protocol.ps1')
+function Check($value,[string]$label){if(-not $value){throw "FAIL hold protocol: $label"}}
+function Reject([scriptblock]$action,[string]$label){$rejected=$false;try{& $action | Out-Null}catch{$rejected=$true};Check $rejected $label}
+$lines=Get-Content -LiteralPath $Fixture
+$cfgLine=@($lines | Where-Object {$_ -like 'HOLD-CFG *'})[0]
+$c=Parse-HoldConfig $cfgLine;Check ($c.cap -eq 3000 -and $c.selected -eq 1800) 'real C configuration'
+Reject {Parse-HoldConfig ($cfgLine.Replace('20261019H1','20261019C3'))} 'reject old firmware'
+Reject {Parse-HoldConfig ($cfgLine.Replace('guard=1500','guard=0'))} 'reject guard mismatch'
+$states=@($lines | Where-Object {$_ -like 'HOLD-STATE *'} | ForEach-Object {Parse-HoldState $_})
+$done=@($states | Where-Object {$_.result -eq 1})[-1]
+Check ($done.n -eq 200 -and $done.sum -eq 4000 -and $done.hold_ms -eq 3000) 'real full-window statistics'
+Check ($done.kick_ticks -eq 3) 'sticky confirmed kick samples'
+Check ((Get-HoldOutcome $done $done.id 1 1800) -eq 'continuous') 'continuous result'
+$doneLine=@($lines | Where-Object {$_ -like 'HOLD-STATE *' -and $_ -match 'result=1 '})[-1]
+$inter=Parse-HoldState ($doneLine.Replace('min=20','min=0').Replace('zeros=0','zeros=1'))
+Check ((Get-HoldOutcome $inter $inter.id 1 1800) -eq 'intermittent') 'intermittent feedback is not continuous'
+Reject {Get-HoldOutcome $done ($done.id+1) 1 1800} 'old trial identity'
+Reject {Get-HoldOutcome $done $done.id 2 1800} 'wrong side'
+$manual=Parse-HoldState ($doneLine.Replace('phase=3 result=1','phase=0 result=0'))
+Reject {Get-HoldOutcome $manual $manual.id 1 1800} 'manual stop is not completion'
+$bad=Parse-HoldState ($doneLine.Replace('fault=0','fault=5'))
+Reject {Get-HoldOutcome $bad $bad.id 1 1800} 'fault is not completion'
+$badKick=Parse-HoldState ($doneLine.Replace('kick_ticks=3','kick_ticks=2'))
+Reject {Get-HoldOutcome $badKick $badKick.id 1 1800} 'unconfirmed kick cannot pass'
+$lost=Parse-HoldState ($doneLine.Replace('result=1','result=2').Replace('total_ms=3200','total_ms=700').Replace('hold_ms=3000','hold_ms=500').Replace('n=200 sum=4000 min=20 max=20 zeros=0','n=0 sum=0 min=0 max=0 zeros=0'))
+Check ((Get-HoldOutcome $lost $lost.id 1 1800) -eq 'lost_motion') 'lost motion is an expected failed measurement'
+Write-Output 'Hold protocol: real C fixture / version / outcome / interruption / identity PASS'
--- C3/code/repair/test_hold.ps1
+++ H1/code/repair/test_hold.ps1
@@ -0,0 +1,75 @@
+param([ValidateSet(1,2)][int]$Motor=1,[ValidateRange(0,30)][int]$DutyPercent=0,[string]$PortName='COM9',[switch]$Run)
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'hold_protocol.ps1')
+$device=Get-CimInstance Win32_SerialPort | Where-Object DeviceID -eq $PortName
+if(-not $device -or $device.PNPDeviceID -notmatch 'VID_2E3C&PID_5740'){throw 'Wrong wireless USB identity'}
+$stamp=[TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow,'China Standard Time').ToString('yyyyMMdd-HHmmss')
+$folder=Join-Path $PSScriptRoot ('evidence\hold-'+$stamp)
+New-Item -ItemType Directory -Path $folder -Force | Out-Null
+$port=[IO.Ports.SerialPort]::new($PortName,115200,[IO.Ports.Parity]::None,8,[IO.Ports.StopBits]::One)
+$port.DtrEnable=$false;$port.RtsEnable=$false;$port.WriteTimeout=300
+$raw=[IO.MemoryStream]::new();$commands=[Collections.Generic.List[object]]::new()
+$failure=$null;$outcome='preflight_only';$completion=$null;$cfg=$null;$pre=$null;$trialId=$null
+$seenKick=$false;$seenHold=$false;$duty=$DutyPercent*100
+function Send([string]$c){$port.Write($c);$commands.Add(@{utc=[DateTime]::UtcNow.ToString('o');command=$c})}
+function Receive([int]$ms){
+    $watch=[Diagnostics.Stopwatch]::StartNew();$buffer=New-Object byte[] 8192
+    while($watch.ElapsedMilliseconds -lt $ms){
+        if($port.BytesToRead){$n=$port.Read($buffer,0,[Math]::Min($buffer.Length,$port.BytesToRead));$raw.Write($buffer,0,$n)}
+        else{Start-Sleep -Milliseconds 5}
+    }
+}
+function Text([int]$offset=0){$b=$raw.ToArray();return [Text.Encoding]::ASCII.GetString($b,$offset,$b.Length-$offset)}
+function States([string]$text){foreach($m in [regex]::Matches($text,'HOLD-STATE [^\r\n]*\r\n')){Parse-HoldState $m.Value}}
+function Config([string]$text){$m=[regex]::Matches($text,'HOLD-CFG [^\r\n]*\r\n');if(-not $m.Count){throw 'No complete H1 config'};return Parse-HoldConfig $m[-1].Value}
+function Idle($s){
+    if(-not $s -or $s.mode -ne 0 -or $s.fault -ne 0 -or $s.pwm_left -ne 0 -or $s.pwm_right -ne 0 -or $s.enc_left -ne 0 -or $s.enc_right -ne 0){throw 'Require idle and zero output/feedback'}
+}
+try{
+    $port.Open();$port.DiscardInBuffer();Send 'H';Receive 650;Send 'q';Receive 500;Send 'H';Receive 650
+    $text=Text;$cfg=Config $text;$states=@(States $text);$pre=$states[-1];Idle $pre
+    if($text -notmatch 'UART8-DIAG[^\r\n]*diag=0 ab=1 ' -or $text -notmatch 'MOTOR-DIR v=20261017I left=C11 cfg=1 sample=[01] right=C9 cfg=0'){throw 'Verified wireless/direction firmware not confirmed'}
+    if($Run){
+        Send ('K'*30);Receive 400;if($DutyPercent){Send ('I'*$DutyPercent);Receive 400}
+        $offset=[int]$raw.Length;Send 'H';Receive 650;$setup=Text $offset;$cfg=Config $setup
+        if($cfg.selected -ne $duty){throw 'Selected hold duty not acknowledged'}
+        $pre=@(States $setup)[-1];Idle $pre;$previousId=$pre.id
+        $offset=[int]$raw.Length;Send $(if($Motor -eq 1){'U'}else{'V'})
+        $clock=[Diagnostics.Stopwatch]::StartNew();$next=0;$lastRx=0;$lastMs=-1
+        while($clock.ElapsedMilliseconds -lt 4600){
+            if($clock.ElapsedMilliseconds -ge $next){Send 'H';$next+=100}
+            Receive 20;$motion=Text $offset
+            if($motion.Contains('HOLD-START REFUSED')){throw 'Hold start refused'}
+            $states=@(States $motion)
+            if($states.Count){
+                $s=$states[-1]
+                if($s.ms -ne $lastMs){$lastMs=$s.ms;$lastRx=$clock.ElapsedMilliseconds}
+                if($s.id -ne $previousId){
+                    if($null -eq $trialId){$trialId=$s.id}
+                    $candidate=Get-HoldOutcome $s $trialId $Motor $duty
+                    $active=if($Motor -eq 1){$s.enc_left}else{$s.enc_right}
+                    $pwm=if($Motor -eq 1){$s.pwm_left}else{$s.pwm_right}
+                    if($s.phase -eq 1 -and $active -ge 5 -and $pwm -eq 3000){$seenKick=$true}
+                    if($s.phase -eq 2){$seenHold=$true;if($s.kick_ticks -eq 3){$seenKick=$true}}
+                    if($candidate -ne 'pending'){$outcome=$candidate;$completion=$s;break}
+                }
+            }
+            if($clock.ElapsedMilliseconds-$lastRx -gt 700){throw 'Hold telemetry stale'}
+        }
+        $ack="HOLD-START v=20261019H1 motor=$Motor duty=$duty kick=3000 kick_min=200 kick_max=300 hold=3000 lease=500 guard=1500"
+        if(-not $completion -or -not $seenKick -or -not $seenHold -or -not (Text $offset).Contains($ack)){throw 'Missing identified kick/drop/automatic outcome evidence'}
+    }
+}catch{$failure=$_.Exception.Message;$outcome='error'}
+finally{
+    if($port.IsOpen){try{Send 's';Send 'H';Receive 450}catch{};$port.Close()};$port.Dispose()
+    [IO.File]::WriteAllBytes((Join-Path $folder 'serial.bin'),$raw.ToArray());$all=@(States (Text));$raw.Dispose()
+    $all | Export-Csv -LiteralPath (Join-Path $folder 'status.csv') -NoTypeInformation -Encoding UTF8
+    $r=[ordered]@{version='20261019H1';motor=$Motor;duty_percent=$DutyPercent;failure=$failure;outcome=$outcome;
+        measurement_complete=($null -ne $completion -and -not $failure);continuous_feedback=($outcome -eq 'continuous');
+        kick_observed=$seenKick;hold_observed=$seenHold;completion=$completion;configuration=$cfg;
+        final=$(if($all.Count){$all[-1]}else{$null});commands=@($commands.ToArray());physical_observation='pending';evidence=$folder}
+    $r | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (Join-Path $folder 'result.json') -Encoding utf8
+    [pscustomobject]@{motor=$Motor;duty_percent=$DutyPercent;outcome=$outcome;failure=$failure;completion=$completion;final=$r.final;evidence=$folder} | ConvertTo-Json -Depth 4
+}
+if($failure){exit 1}
+exit 0
